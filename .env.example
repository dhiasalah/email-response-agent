# Copy to .env (git-ignored); Quarkus reads it at start. Example values only: never commit real secrets.

# draft | auto. Gmail mode accepts draft only.
SEND_MODE=draft
OWNER_ADDRESS=prof.martin@univ.example
# PBKDF2 hash of the review panel password; empty = the panel refuses every login.
# Generate with: java src/main/java/com/emailagent/web/PasswordHash.java '<password>'
OWNER_PASSWORD_HASH=

# Local models (Ollama). On a low-RAM PC: FAST_MODEL=qwen2.5:3b
OLLAMA_HOST=http://127.0.0.1:11434
FAST_MODEL=qwen2.5:7b
STRONG_MODEL=qwen2.5:7b
EMBED_MODEL=nomic-embed-text

# Specialized agents: one JSON file per agent (prompt, routing hints, context files). See agents/README.md.
AGENTS_DIR=agents

# mock (JSON fixtures) | gmail (the owner's Gmail, drafts only)
MAILBOX=mock
# Gmail mode reads only these senders, comma-separated; empty = nothing is read.
GMAIL_ALLOWED_SENDERS=
# Sender authentication (DMARC, or DKIM signed by the sender's domain): unset = on for gmail, off for mock.
# Gmail mode refuses false. A sender that fails is still shown to you, but gets no scope: no grouping, no reuse
# of stored answers, never sent automatically. If your university's mail is not DKIM-signed, every student
# will show "sender not authenticated" in the panel: ask IT to enable DKIM/DMARC for the domain.
# EMAILAGENT_REQUIRE_SENDER_AUTH=true

# Finished emails are erased after this many days.
RETENTION_DAYS=365

# Production database (dev and test start PostgreSQL in Docker by themselves).
DB_URL=jdbc:postgresql://localhost:5432/emailagent
DB_USER=emailagent
DB_PASSWORD=
